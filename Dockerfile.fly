# Single-VM image for Fly.io demo: FastAPI + Next.js in one container.
# - Stage 1 builds the Next.js production bundle.
# - Stage 2 is the runtime: Python 3.12 + Node 20 runtime + the API package.
# Migrations run at boot ; SQLite lives on a mounted Fly volume at /data.

# Stage 1: Next.js production build.
FROM node:20-alpine AS web-build
WORKDIR /build
COPY web/package.json web/package-lock.json* ./
RUN npm ci --include=dev
COPY web ./
RUN npm run build

# Stage 2: final runtime image — Python (API) + Node (Next.js server).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AEDIFICA_ENV=prod \
    AEDIFICA_DATABASE_URL="sqlite:////data/aedifica.db" \
    AEDIFICA_API="http://127.0.0.1:8090" \
    AEDIFICA_CORS_ORIGINS="*" \
    NODE_ENV=production \
    PORT=3000

COPY pyproject.toml alembic.ini ./
COPY aedifica ./aedifica
COPY pilot ./pilot
COPY tests/contracts ./tests/contracts
RUN pip install -e ".[product]"

# Copy the pre-built Next.js standalone-ish bundle (node_modules + .next + public).
COPY --from=web-build /build /app/web

COPY scripts/fly-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
CMD ["/entrypoint.sh"]
