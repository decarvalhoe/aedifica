# Copy to .env on the VM and fill in. Never commit the filled file.

# Public hostname served by Caddy. Use ":80" to rehearse over plain HTTP before
# DNS points at the VM; use the bare hostname to get automatic Let's Encrypt TLS.
AEDIFICA_SITE=demo.example.com

# Origin the browser uses, sent to the API as the allowed CORS origin.
PUBLIC_ORIGIN=https://demo.example.com

# Contact address for the ACME account (certificate expiry notices).
ACME_EMAIL=you@example.com

# Database. Generate with: openssl rand -base64 32
POSTGRES_USER=aedifica
POSTGRES_PASSWORD=
POSTGRES_DB=aedifica

# Demo behaviour, mirroring the previous Fly deployment.
AEDIFICA_NOMOS_ENABLED=true
AEDIFICA_SEED_DEMO=true
AEDIFICA_RESET_ATELIERS=true
