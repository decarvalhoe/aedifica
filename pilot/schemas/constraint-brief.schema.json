{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aedifica.dev/schemas/constraint-brief-1.0.json",
  "title": "Aedifica project-scoped constraint brief",
  "description": "Structured brief generated from a project manifest: constraints, envelope, risks, unknowns and source refs. Schema version 1.0.",
  "type": "object",
  "required": [
    "schema_version",
    "brief_id",
    "project_id",
    "generated_at",
    "project_summary",
    "source_refs",
    "regulatory_route",
    "constraints",
    "envelope",
    "envelope_claims",
    "claims",
    "risks",
    "residual_unknowns",
    "trust_footer"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "brief_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_summary": {
      "type": "object",
      "required": ["project_id"],
      "properties": { "project_id": { "type": "string", "minLength": 1 } }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": { "source_id": { "type": "string", "minLength": 1 } }
      }
    },
    "regulatory_route": {
      "type": "object",
      "required": ["route_id", "active_layers"],
      "properties": { "active_layers": { "type": "array", "minItems": 1 } }
    },
    "constraints": { "type": "array", "minItems": 1 },
    "envelope": { "type": "object" },
    "envelope_claims": { "type": "array", "minItems": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "title", "state"],
        "properties": {
          "state": { "enum": ["sourced", "computed", "assumption", "unknown", "conflict", "decision"] }
        }
      }
    },
    "risks": {
      "type": "object",
      "required": ["overall"]
    },
    "residual_unknowns": { "type": "array" },
    "trust_footer": { "type": "string", "minLength": 1 }
  }
}
