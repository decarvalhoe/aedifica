{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aedifica.dev/schemas/project-manifest-1.0.json",
  "title": "Aedifica project manifest",
  "description": "Durable project object at the centre of the Aedifica workspace. Schema version 1.0.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "name",
    "phase_code",
    "jurisdiction",
    "regulatory_route",
    "trust_contract"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "description": "Manifest schema version. Bump only on a breaking change.",
      "const": "1.0"
    },
    "project_id": {
      "description": "Stable project identifier: 3-64 chars of A-Z, 0-9, underscore or hyphen.",
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "phase_code": {
      "description": "SIA phase code for the project's current phase.",
      "enum": ["0", "1", "2", "31", "32", "33", "41", "51", "52", "53", "61-63"]
    },
    "knowledge_regime": {
      "type": "string",
      "enum": ["context_first", "hybrid_index", "project_rag"]
    },
    "jurisdiction": {
      "type": "object",
      "required": ["country", "canton", "commune"],
      "properties": {
        "country": { "type": "string", "minLength": 1 },
        "canton": { "type": "string", "minLength": 1 },
        "commune": { "type": "string", "minLength": 1 }
      }
    },
    "parcel": {
      "type": "object"
    },
    "regulatory_route": {
      "type": "object",
      "required": [
        "schema_version",
        "route_id",
        "country",
        "canton",
        "commune",
        "selected_at",
        "evaluated_at",
        "active_layers",
        "inactive_layers"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "route_id": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "canton": { "type": "string", "minLength": 1 },
        "commune": { "type": "string", "minLength": 1 },
        "selected_at": { "type": "string", "format": "date-time" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "active_layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["layer_id", "level", "jurisdiction", "state"],
            "properties": {
              "level": { "enum": ["federal", "cantonal", "communal"] },
              "state": { "const": "active" }
            }
          }
        },
        "inactive_layers": { "type": "array" },
        "freshness_warnings": { "type": "array" }
      }
    },
    "trust_contract": {
      "type": "object",
      "required": ["language", "footer_required", "required_claim_states"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "footer_required": { "const": true },
        "required_claim_states": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        }
      }
    }
  }
}
